# Copy to .env and fill in. `npm start` loads .env when it exists.

# "ID do cliente" and "Segredo do cliente" shown when you create the app in Meus apps.
# Keep the secret on the server only.
CLICKMAX_CLIENT_ID=
CLICKMAX_CLIENT_SECRET=

# Login server that runs the install authorization and issues tokens.
CLICKMAX_LOGIN_BASE_URL=https://login.clickmax.io

# Clickmax API the installation tokens are valid for.
CLICKMAX_API_BASE_URL=https://mcp.clickmax.io/api/v0

# Must be one of the app's redirect URLs, exactly as registered in Meus apps.
CLICKMAX_REDIRECT_URL=http://127.0.0.1:3000/callback

# Port this sample listens on (127.0.0.1 only). Register http://127.0.0.1:<PORT>/clickmax/setup
# as the app's Setup URL to receive installs started in Clickmax.
PORT=3000
